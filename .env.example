# Template only. Every value below is a placeholder and is rejected at startup.
# Real values live outside the repository (see docs/ops/secrets-management.md).
ALVO_ENVIRONMENT=development
ALVO_DATABASE_URL=postgresql://alvo_app:CHANGE_ME@db:5432/alvo
ALVO_SESSION_SECRET=CHANGE_ME
# Optional (defaults are safe): public origin the PWA is served from, session lifetimes,
# and the development-only mock identity provider (forbidden when ENVIRONMENT=production).
# ALVO_PUBLIC_ORIGIN=https://localhost:8000
# ALVO_SESSION_IDLE_MINUTES=30
# ALVO_SESSION_ABSOLUTE_MINUTES=720
# ALVO_IDENTITY_PROVIDER=none
# ALVO_ADMIN_RECENT_LOGIN_MINUTES=15
# Global ceilings for per-user AI limits an admin may grant (0 grants nothing):
# ALVO_AI_MAX_REQUESTS_PER_DAY=0
# ALVO_AI_MAX_MONTHLY_UNITS=0
# ALVO_MAX_REQUEST_BYTES=1048576
# ALVO_MAX_IMPORT_BYTES=2097152
# ALVO_IMPORT_COMMITS_PER_HOUR=30
